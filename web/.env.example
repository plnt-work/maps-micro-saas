# Google Maps JavaScript API key. Without this, the Maps page renders a
# placeholder card instead of a real map (chat still works).
# Get one: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_KEY=

# Admin bearer token. Match PLNT_CLOUD_ADMIN_TOKEN on the uvicorn side.
VITE_ADMIN_TOKEN=

# Default tenant the Maps surface chats as. Provision it first via the admin API.
VITE_DEFAULT_TENANT=demo
