# Expo dev env for the plnt-cloud mobile app.
# Copy to mobile/.env.development and fill in the two hostnames the
# Cloudflare named tunnel exposes (see plnt-cloud/docker-compose.yml).
#
# When the local stack is up (`docker compose up -d` from plnt-cloud/),
# the cloudflared service binds to a named tunnel whose Public
# Hostnames in the Zero Trust dashboard route:
#     api.dev.<your-zone>   →  http://api:8080
#     ws.dev.<your-zone>    →  http://api:8080/ws
# Set those URLs below. EXPO_PUBLIC_* vars are inlined into the Expo
# bundle at build time and are safe to commit per-developer.

EXPO_PUBLIC_API_BASE=https://api.dev.example.com
EXPO_PUBLIC_WS_BASE=wss://ws.dev.example.com
EXPO_PUBLIC_TENANT_ID=demo
