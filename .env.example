# Slice-5a merchant onboarding — copy the keys you need into .env (gitignored).
# GOOGLE_OAUTH_CLIENT_ID=        # Google OAuth web client id (identity-only scopes)
# GOOGLE_OAUTH_CLIENT_SECRET=    # matching client secret, used server-side for the code exchange
# PLNT_CLOUD_SESSION_SECRET=     # HMAC key for the onboarding session cookie; unset = ephemeral per-process (dev only)
# PLNT_CLOUD_PUBLIC_URL=http://localhost:8080   # public base URL of this API; builds the OAuth redirect URI
